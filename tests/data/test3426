<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTPS proxy
cookies
Secure
</keywords>
</info>

# Server-side
<reply>
<data crlf="headers">
HTTP/1.1 200 OK
Content-Length: 4

foo
</data>
</reply>

# Client-side
<client>
<server>
http
http-proxy
</server>
<features>
proxy
cookies
</features>
<name>
HTTP loopback through proxy does not send Secure cookies
</name>
<command>
--noproxy "" -x http://%HOSTIP:%PROXYPORT -b %LOGDIR/jar%TESTNUMBER.txt http://localhost/%TESTNUMBER
</command>
<file name="%LOGDIR/jar%TESTNUMBER.txt">
# Netscape HTTP Cookie File
localhost	FALSE	/	TRUE	9999999999	session	secret
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<proxy crlf="headers">
GET http://localhost/%TESTNUMBER HTTP/1.1
Host: localhost
User-Agent: curl/%VERSION
Accept: */*
Proxy-Connection: Keep-Alive

</proxy>
</verify>
</testcase>
