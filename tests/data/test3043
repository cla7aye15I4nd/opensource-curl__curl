<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP CONNECT
HTTP proxy
connection reuse
</keywords>
</info>

<reply>
<connect crlf="headers">
HTTP/1.1 200 Tunnel established

</connect>
<data crlf="headers" nocheck="yes">
HTTP/1.1 200 OK
Content-Length: 0

</data>
</reply>

<client>
<server>
http
http-proxy
</server>
<features>
proxy
</features>
<name>
CONNECT tunnel reuse with changed and unchanged proxy authorization
</name>
<command>
--fail-early --proxytunnel -x %HOSTIP:%PROXYPORT --proxy-header "Proxy-Authorization: Bearer test-a" http://%HOSTIP:%HTTPPORT/%TESTNUMBER --next --proxytunnel -x %HOSTIP:%PROXYPORT --proxy-header "proxy-authorization: Bearer test-b" http://%HOSTIP:%HTTPPORT/%TESTNUMBER --next --proxytunnel -x %HOSTIP:%PROXYPORT --proxy-header "proxy-authorization: Bearer test-b" http://%HOSTIP:%HTTPPORT/%TESTNUMBER
</command>
</client>

<verify>
<proxy crlf="headers">
CONNECT %HOSTIP:%HTTPPORT HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive
Proxy-Authorization: Bearer test-a

CONNECT %HOSTIP:%HTTPPORT HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive
proxy-authorization: Bearer test-b

</proxy>
</verify>
</testcase>
