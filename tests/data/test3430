<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
header_json
</keywords>
</info>
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
X-Large: %repeat[55000 x \]%
X-Large: end
Content-Length: 0
Connection: close

</data>
</reply>
<client>
<features>
headers-api
</features>
<server>
http
</server>
<name>
header_json preserves values escaping beyond 100000 bytes
</name>
<command option="no-output">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -w '%{header_json}\n' -o %LOGDIR/%TESTNUMBER.out
</command>
</client>
<verify>
<stdout mode="text">
{"x-large":["%repeat[55000 x \\]%","end"],
"content-length":["0"],
"connection":["close"]
}
</stdout>
</verify>
</testcase>
