<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
compressed
</keywords>
</info>
<reply>
# A streaming zstd frame with an 8 MiB window and one raw byte.
<data crlf="headers" nonewline="yes" nocheck="yes">
HTTP/1.1 200 OK
Content-Encoding: zstd
Content-Length: 10

%hex[%28%b5%2f%fd%00%68%09%00%00%77]hex%
</data>
# The same frame with an 8.5 MiB window.
<data1 crlf="headers" nonewline="yes" nocheck="yes">
HTTP/1.1 200 OK
Content-Encoding: zstd
Content-Length: 10

%hex[%28%b5%2f%fd%00%69%09%00%00%77]hex%
</data1>
</reply>
<client>
<features>
zstd
</features>
<server>
http
</server>
<name>
HTTP zstd streaming window limit
</name>
<precheck>
%CURL --version | %PERL -ne 'print "Needs zstd 1.4.0 or newer\n" if m{\bzstd/1\.[0-3]\.}'
</precheck>
<command option="no-include">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --compressed -o %LOGDIR/zstd-ok -w '%{exitcode}\n' --next http://%HOSTIP:%HTTPPORT/%TESTNUMBER0001 --compressed --remove-on-error -o %LOGDIR/zstd-too-big -w '%{exitcode}\n'
</command>
</client>
<verify>
<file name="%LOGDIR/zstd-ok" nonewline="yes">
w
</file>
<notexists>
%LOGDIR/zstd-too-big
</notexists>
<stdout mode="text">
0
61
</stdout>
<errorcode>
61
</errorcode>
</verify>
</testcase>
