Content-Length: 0
Connection: close

</data>
</reply>

<client>
<features>
HSTS
alt-svc
getrlimit
</features>
<server>
http
</server>
<name>
Keep HSTS and Alt-Svc caches after a partial file write
</name>
<command option="no-memdebug">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER %LOGDIR/hsts-ok %LOGDIR/alt-ok %LOGDIR/hsts-limited %LOGDIR/alt-limited
</command>
<file name="%LOGDIR/hsts-ok" mode="text">
